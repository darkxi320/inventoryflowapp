// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String   @unique
  activePlan    String?
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model Inventory {
  id       Int     @id @default(autoincrement())
  sku      String  @unique
  quantity Int
  price    Float
}

model Shop {
  id               Int                      @id @default(autoincrement())
  shopDomain       String                   @unique
  activePlan       String?  
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  accessToken      String?                  // Make accessToken nullable
  inventoryUpdates PriceInventoryUpdation[]
  products         Product[]                // Relating to products that belong to the shop
}

model PriceInventoryUpdation {
  id              Int     @id @default(autoincrement())
  productId       String
  sku             String
  quantity        Int
  price           Float
  locationId      String
  shopDomain      String
  shop            Shop    @relation(fields: [shopDomain], references: [shopDomain])
  productName     String?
  productDescription String?
  manufacturerName String?

  // Adding a composite unique constraint to prevent duplicate records for the same SKU and shop
  @@unique([shopDomain, sku])
}

model Product {
  id               Int      @id @default(autoincrement())
  productName      String
  productDescription String
  manufacturerName String
  sku              String   @unique
  price            Float
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  shopDomain       String
  shop             Shop     @relation(fields: [shopDomain], references: [shopDomain])
  variants         ProductVariant[]
}

model ProductVariant {
  id            Int      @id @default(autoincrement())
  productId     Int
  variantName   String
  sku           String   @unique
  inventoryQty  Int
  price         Float
  product       Product  @relation(fields: [productId], references: [id])
}








